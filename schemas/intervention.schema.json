{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mavs-research.example/schemas/intervention.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["intervention_id", "source_state_id", "preconditions", "atomicity", "positive_support_successors", "public_effect", "provenance_fact_ids", "cost"],
  "properties": {
    "intervention_id": {"type": "string", "pattern": "^action:[a-z0-9_:-]+$"},
    "source_state_id": {"type": "string", "pattern": "^state:[a-z0-9_:-]+$"},
    "preconditions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "atomicity": {"type": "object", "additionalProperties": false, "required": ["is_atomic", "basis"], "properties": {"is_atomic": {"const": true}, "basis": {"type": "string"}}},
    "positive_support_successors": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["state_id", "support"], "properties": {"state_id": {"type": "string"}, "support": {"type": "integer", "minimum": 1}}}},
    "public_effect": {"type": "string"},
    "provenance_fact_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^fact:[0-9a-f]{20}$"}},
    "cost": {"type": "object", "additionalProperties": false, "required": ["unit", "native"], "properties": {"unit": {"const": 1}, "native": {"type": ["number", "null"]}}}
  }
}
