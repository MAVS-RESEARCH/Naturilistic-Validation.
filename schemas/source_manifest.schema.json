{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mavs-research.example/schemas/source_manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "external_system_id", "repository_origin", "pre_ref", "post_ref", "pr_head_ref", "historical_change_id", "artifacts", "source_tree_hash", "environment_ref", "created_at", "fetch_verification", "manifest_hash"],
  "properties": {
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
    "external_system_id": {"type": "string"},
    "repository_origin": {"type": "string", "format": "uri"},
    "pre_ref": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "post_ref": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "pr_head_ref": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "historical_change_id": {"type": "string"},
    "source_tree_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "environment_ref": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},
    "fetch_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pass_count", "object_types_valid", "ancestry_valid", "tree_ids_equal", "artifact_hashes_equal", "cache_path_invariant", "history_fetches_equal"],
      "properties": {
        "pass_count": {"const": 2},
        "object_types_valid": {"const": true},
        "ancestry_valid": {"const": true},
        "tree_ids_equal": {"const": true},
        "artifact_hashes_equal": {"const": true},
        "cache_path_invariant": {"const": true},
        "history_fetches_equal": {"const": true}
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "phase", "source_ref", "source_path", "snapshot_path", "role", "allowed_influence", "byte_sha256", "semantic_sha256", "size_bytes"],
        "properties": {
          "artifact_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{2,127}$"},
          "phase": {"enum": ["pre", "post", "history"]},
          "source_ref": {"type": "string"},
          "source_path": {"type": "string", "minLength": 1},
          "snapshot_path": {"type": "string", "minLength": 1},
          "role": {"enum": ["SOURCE_SEMANTICS", "NATIVE_TARGET", "NATIVE_TEST", "HISTORICAL_REPAIR", "EVALUATOR_ONLY", "EXCLUDED"]},
          "allowed_influence": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "byte_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "semantic_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 0}
        }
      }
    },
    "manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
