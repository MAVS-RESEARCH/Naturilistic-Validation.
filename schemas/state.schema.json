{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mavs-research.example/schemas/state.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["state_id", "history_domain", "normalized_evidence_hash", "representation_partition", "authority", "controller_observation", "terminal_certificates", "source_fact_ids"],
  "properties": {
    "state_id": {"type": "string", "pattern": "^state:[a-z0-9_:-]+$"},
    "history_domain": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^history:[0-9a-f]{20}$"}},
    "normalized_evidence_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "representation_partition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["history_domain", "blocks", "partition_hash"],
      "properties": {
        "history_domain": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "blocks": {"type": "array", "minItems": 1, "items": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}},
        "partition_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entries", "authority_hash"],
      "properties": {
        "entries": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["kind", "identifier", "admissible", "provenance_fact_ids"], "properties": {"kind": {"enum": ["SOURCE", "FIELD", "PREDICATE", "ATTESTATION", "CHECK"]}, "identifier": {"type": "string"}, "admissible": {"type": "boolean"}, "provenance_fact_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}}}},
        "authority_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "controller_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visible_fields", "contains_evaluator_truth", "observation_hash"],
      "properties": {
        "visible_fields": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "contains_evaluator_truth": {"const": false},
        "observation_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "terminal_certificates": {"type": "object", "additionalProperties": {"type": "boolean"}},
    "source_fact_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^fact:[0-9a-f]{20}$"}}
  }
}
