{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mavs-research.example/schemas/control_result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["control_id", "transformation", "transformation_input", "expected_invariant", "observed_result", "evidence", "passed"],
  "properties": {
    "control_id": {"pattern": "^C(?:[1-9]|10)_[A-Z0-9_]+$", "type": "string"},
    "transformation": {"type": "string", "minLength": 1},
    "transformation_input": {"type": "object"},
    "expected_invariant": {"type": "string", "minLength": 1},
    "observed_result": {"type": "object"},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "passed": {"type": "boolean"}
  }
}
