{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mavs-research.example/schemas/phase1_eligibility.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "overall_status", "phase2_authorized", "gates", "metrics", "target_recovery", "route_surface", "native_replay", "limitations", "source_manifest_hash", "preregistration_hash", "eligibility_report_hash"],
  "properties": {
    "run_id": {"type": "string"},
    "overall_status": {"enum": ["ELIGIBLE", "INELIGIBLE"]},
    "phase2_authorized": {"type": "boolean"},
    "gates": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "passed", "evidence", "reason_codes"],
        "properties": {
          "id": {"pattern": "^P1-E[1-8]$"},
          "name": {"type": "string"},
          "passed": {"type": "boolean"},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "reason_codes": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "metrics": {"type": "object"},
    "target_recovery": {"type": "object"},
    "route_surface": {"type": "object"},
    "native_replay": {"type": "object"},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "source_manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "preregistration_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "eligibility_report_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}

